# dependencies
node_modules

# Next.js build output
.next
/out

# secrets: never commit real environment files (only .env.example is tracked)
.env*
!.env.example

# credentials, key material, database dumps, backups and archives must never be committed or shared
*.pem
*.key
*.p12
*.pfx
*.dump
*.pgdump
*.sql.gz
*.bak
*.zip

# Vercel
.vercel

# logs, OS and tooling files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
next-env.d.ts
*.tsbuildinfo
/coverage

# local profile data (Office System profiles / pictures)
/data
