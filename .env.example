# NEVER put real values in this file. Copy it to .env.local (already git-ignored)
# for local work, and set the same names in your hosting provider's environment
# variables (e.g. Vercel: Project Settings -> Environment Variables).

# ---- Email (SMTP, works with any provider that offers SMTP) ----
# Where transaction requests are delivered (the Assessor's Office inbox)
OFFICE_EMAIL_TO=
# Sender shown on outgoing mail, e.g. "Assessor Web <no-reply@yourdomain.ph>"
SMTP_FROM=
# SMTP server details from your email provider
SMTP_HOST=
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true
SMTP_PORT=587
SMTP_SECURE=false
# SMTP login (leave both empty only if your server needs no authentication)
SMTP_USER=
SMTP_PASS=

# ---- Employee/Admin auth ----
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
EMPLOYEE_USERNAME=
# Base64 of a bcrypt hash. Generate it with the command in README.md.
EMPLOYEE_PASSWORD_HASH_B64=
